# ==============================================================================
# Production Environment Configuration Template
# Copy this file to .env on the production server and set secure values.
# NEVER commit the real production .env to version control!
# ==============================================================================

# Django Core Security
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here-for-prod
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,127.0.0.1

# PostgreSQL Production Database
DB_NAME=youtube_prod_db
DB_USER=youtube_prod_user
DB_PASSWORD=generate_a_very_strong_password_here
DB_HOST=db
DB_PORT=5432

# CORS & CSRF Origins (Production URLs)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Google YouTube Data API v3
YOUTUBE_API_KEY=AIzaSy_your_production_google_api_key_here

# Gunicorn Process Settings
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# Logging Level (INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO
